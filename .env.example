# ─── LLM (Anthropic API) ─────────────────────────────────────────────────────
# The agent always calls Anthropic directly — locally and on AgentCore Runtime.
# Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
ANTHROPIC_GUARDRAIL_MODEL_ID=claude-haiku-4-5

# AWS region (AgentCore deploy/invoke path; also used when EMBEDDINGS_PROVIDER=bedrock).
AWS_REGION=us-east-1
# Only needed if not using an AWS profile / instance role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Embeddings ───────────────────────────────────────────────────────────────
# "fastembed" (local default, no key) or "bedrock" (Titan).
EMBEDDINGS_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# Vector dimension MUST match the active embedder: bge-small-en-v1.5 = 384, Titan v2 = 1024.
EMBEDDING_DIM=384
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0

# ─── Database ─────────────────────────────────────────────────────────────────
# Async URL (psycopg3) for the app; docker-compose overrides the host to "postgres".
DATABASE_URL=postgresql+psycopg://promate:promate@localhost:5432/promate
# Sync URL for the LangGraph Postgres checkpointer.
DATABASE_URL_SYNC=postgresql://promate:promate@localhost:5432/promate

# ─── Stripe (test mode) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3000/cart

# ─── Observability (optional) ─────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=promate

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

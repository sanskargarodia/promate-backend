# ─── LLM (Anthropic API) ─────────────────────────────────────────────────────
# The agent always calls Anthropic directly — locally and on AgentCore Runtime.
# Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
ANTHROPIC_GUARDRAIL_MODEL_ID=claude-haiku-4-5

# AWS region (AgentCore deploy/invoke path; also used when EMBEDDINGS_PROVIDER=bedrock).
AWS_REGION=us-east-1
# Only needed if not using an AWS profile / instance role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Embeddings ───────────────────────────────────────────────────────────────
# "fastembed" (local default, no key) or "bedrock" (Titan).
EMBEDDINGS_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# Vector dimension MUST match the active embedder: bge-small-en-v1.5 = 384, Titan v2 = 1024.
EMBEDDING_DIM=384
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0

# ─── Database ─────────────────────────────────────────────────────────────────
# Async URL (psycopg3) for the app. Docker maps Postgres to host port 5433 (avoids
# conflict with a local PostgreSQL install often bound to 5432).
DATABASE_URL=postgresql+psycopg://promate:promate@localhost:5433/promate
# Sync/libpq URL for LangGraph Postgres checkpointer (psycopg conninfo).
DATABASE_URL_SYNC=postgresql://promate:promate@localhost:5433/promate

# Optional local parts.csv validation at startup (defaults to DB row-count check only)
# CATALOG_CSV_PATH=data/parts.csv

# ─── Observability (optional) ─────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=promate

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

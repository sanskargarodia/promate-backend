# Copy to deploy/env.agentcore.local (gitignored) and fill in values.
# Pass to deploy: see deploy/README.md — agentcore deploy --env-file ...

# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASS@your-aurora-host:5432/promate
DATABASE_URL_SYNC=postgresql://USER:PASS@your-aurora-host:5432/promate
AWS_REGION=us-east-1

# ─── Recommended for cloud ───────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
EMBEDDINGS_PROVIDER=bedrock
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
ANTHROPIC_GUARDRAIL_MODEL_ID=claude-haiku-4-5

# ─── Optional ─────────────────────────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=promate

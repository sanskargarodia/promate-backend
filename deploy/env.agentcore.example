# Copy to deploy/env.agentcore.local (gitignored) and fill in values.
# Pass to deploy: see deploy/README.md — agentcore deploy --env-file ...

# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Aurora host is pre-filled; replace PASSWORD with deploy/aurora-credentials.json value.
DATABASE_URL=postgresql+psycopg://promate_admin:PASSWORD@promate-cluster.cluster-cmtsw84oojhj.us-east-1.rds.amazonaws.com:5432/promate?sslmode=require
DATABASE_URL_SYNC=postgresql://promate_admin:PASSWORD@promate-cluster.cluster-cmtsw84oojhj.us-east-1.rds.amazonaws.com:5432/promate?sslmode=require
AWS_REGION=us-east-1

# ─── Recommended for cloud ───────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
# Keep fastembed: no Bedrock model access needed (Bedrock = agent host only), and it
# matches the 384-dim vectors written when you import the catalog into Aurora below.
EMBEDDINGS_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
ANTHROPIC_GUARDRAIL_MODEL_ID=claude-haiku-4-5

# ─── Optional ─────────────────────────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=promate
